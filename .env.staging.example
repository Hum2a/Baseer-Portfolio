# Copy to .env.staging — used by `npm run secrets:sync:staging`
# Do not commit real secrets.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Optional — S3-style R2 presigns (otherwise Worker proxy is used)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=baseer-portfolio-staging
